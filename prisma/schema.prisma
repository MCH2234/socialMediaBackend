// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generate/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  user            String          @unique
  password        String
  first           String
  last            String
  followers       User[]          @relation("UserFollow")
  following       User[]          @relation("UserFollow")
  post            Post[]
  comments        Comment[]
  sendRequest     FollowRequest[] @relation("SentRequest")
  receivedRequest FollowRequest[] @relation("ReceivedRequest")
  postLikes       PostLikes[]
  commentLikes    CommentLikes[]

  @@map("users")
}

model FollowRequest {
  id     String @id @default(uuid())
  status String @default("Pending")
  fromId String
  toId   String
  from   User   @relation("SentRequest", fields: [fromId], references: [id])
  to     User   @relation("ReceivedRequest", fields: [toId], references: [id])

  @@unique([fromId, toId])
}

model Post {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete:Cascade)
  text     String      @db.VarChar(250)
  date     DateTime
  likes    PostLikes[]
  comments Comment[]

  @@map("posts")
}

model PostLikes {
  id     Int    @id @default(autoincrement())
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id])
  post   Post   @relation(fields: [postId], references: [id], onDelete:Cascade)
}

model Comment {
  id              String         @id @default(uuid())
  text            String         @db.VarChar(100)
  postId          String?
  userId          String
  likes           CommentLikes[]
  date            DateTime
  post            Post?          @relation(fields: [postId], references: [id],onDelete:Cascade)
  user            User           @relation(fields: [userId], references: [id])
  parentCommentId String?
  parentComment   Comment?       @relation("SubComments", fields: [parentCommentId], references: [id], onDelete:Cascade)
  childComments   Comment[]      @relation("SubComments")

  @@map("comments")
}

model CommentLikes {
  id        Int     @id @default(autoincrement())
  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id])
  comment   Comment @relation(fields: [commentId], references: [id],onDelete:Cascade)
}
